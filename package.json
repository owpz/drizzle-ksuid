{
  "name": "@owpz/drizzle-ksuid",
  "version": "1.0.0",
  "description": "Drizzle ORM extension for generating K-Sortable Unique IDs (KSUIDs)",
  "author": "Apex Innovations, Inc.",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "lint": "eslint \"src/**/*.ts\"",
    "prepublishOnly": "npm run clean && npm run build && npm test",
    "test": "jest --testPathIgnorePatterns=e2e",
    "test:all": "jest",
    "test:coverage": "jest --coverage --testPathIgnorePatterns=e2e",
    "test:watch": "jest --watch --testPathIgnorePatterns=e2e",
    "test:e2e": "jest --testPathPattern=e2e",
    "test:e2e:postgres": "jest __tests__/e2e-postgres.test.ts",
    "test:e2e:mysql": "jest __tests__/e2e-mysql.test.ts",
    "test:fuzz": "jest __tests__/fuzz.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "docker:up": "docker-compose -f docker-compose.test.yml up -d",
    "docker:down": "docker-compose -f docker-compose.test.yml down -v",
    "docker:test": "npm run docker:up && sleep 5 && npm run test:e2e; npm run docker:down"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "drizzle-orm": ">=0.23.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/jest": "^29.5.14",
    "@types/node": "^18.0.0",
    "@types/pg": "^8.11.0",
    "@types/sql.js": "1.4.9",
    "better-sqlite3": "11.0.0",
    "drizzle-kit": "^0.20.0",
    "drizzle-orm": "^0.33.0",
    "eslint": "^9.25.1",
    "fast-check": "4.3.0",
    "jest": "^29.7.0",
    "mysql2": "^3.11.0",
    "pg": "^8.11.3",
    "sql.js": "1.13.0",
    "ts-jest": "^29.3.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.31.0"
  },
  "keywords": [
    "drizzle",
    "drizzle-orm",
    "extension",
    "ksuid",
    "id",
    "uuid",
    "sortable",
    "typescript",
    "orm"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/owpz/drizzle-ksuid.git"
  },
  "bugs": {
    "url": "https://github.com/owpz/drizzle-ksuid/issues"
  },
  "homepage": "https://github.com/owpz/drizzle-ksuid",
  "eslint": {
    "configFile": "eslint.config.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@owpz/ksuid": "^25.7.20"
  }
}
